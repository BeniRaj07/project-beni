# Copy this file to .env and fill in your keys. Never commit .env.

# ── Required API keys ─────────────────────────────────────────────
ANTHROPIC_API_KEY=       # https://console.anthropic.com/settings/keys  (Claude chat LLM; used instead of Groq's LLM when set)
GROQ_API_KEY=            # https://console.groq.com/keys  (speech-to-text + LLM / intent classification)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey  (optional: backup text-to-speech only)
NEWS_API_KEY=            # https://newsapi.org/register
FOOTBALL_DATA_KEY=       # https://www.football-data.org/client/register

# ── Optional settings (defaults shown) ────────────────────────────
# APP_TIMEZONE=Asia/Kathmandu
# DEFAULT_CITY=Kathmandu               # used for weather/the daily briefing until you mention a city
# LLM_PROVIDER=                        # anthropic | groq (blank = Claude if ANTHROPIC_API_KEY is set)
# ANTHROPIC_MODEL=claude-opus-5-5      # claude-sonnet-5-5 is cheaper/faster
# GROQ_LLM_MODEL=openai/gpt-oss-20b
# GROQ_STT_MODEL=whisper-large-v3
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_VOICE=Kore

# Text-to-speech engine tried first for each language: groq | gemini | edge
# (the other is used automatically as a fallback if the first one fails or has no key).
# Groq TTS is the primary English engine and edge-tts the primary Nepali one (Groq has no Nepali).
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english   # English only; accept its terms in the Groq console
# GROQ_TTS_VOICE=hannah                        # autumn | diana | hannah | austin | daniel | troy
# TTS_ENGINE_EN=groq
# TTS_ENGINE_NE=edge
# EDGE_VOICE_EN=en-US-JennyNeural
# EDGE_VOICE_NE=ne-NP-HemkalaNeural     # or ne-NP-SagarNeural (male)

# WAKE_PHRASES=Hey Aawaz,Aawaz         # comma-separated; heard by the browser's passive wake-word listener
# REMINDER_CHECK_SECONDS=20
# HTTP_TIMEOUT=15
# SERVER_HOST=127.0.0.1                 # keep 127.0.0.1 for a local, single-user app
# SERVER_PORT=7860
# APP_AUTH=username:password            # set this if you ever expose the app beyond localhost
# DATA_DIR=data                         # folder holding conversations/reminders/tasks/settings.json
