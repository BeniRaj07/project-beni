# Copy this file to .env and fill in your keys. Never commit .env.

# ── Required API keys ─────────────────────────────────────────────
ANTHROPIC_API_KEY=       # https://console.anthropic.com/settings/keys  (LLM: intent classification, small talk, news summaries)
GROQ_API_KEY=            # https://console.groq.com/keys  (speech-to-text only - Anthropic has no audio API)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey  (text-to-speech)
NEWS_API_KEY=            # https://newsapi.org/register
FOOTBALL_DATA_KEY=       # https://www.football-data.org/client/register
ELEVENLABS_API_KEY=      # https://elevenlabs.io/app/settings/api-keys  (optional; see TTS engines below)

# ── Optional settings (defaults shown) ────────────────────────────
# APP_TIMEZONE=Asia/Kathmandu
# DEFAULT_CITY=Kathmandu               # used for weather/the daily briefing until you mention a city
# CLAUDE_MODEL=claude-haiku-4-5        # fast/cheap, plenty for intent classification + small talk;
                                        # bump to claude-sonnet-5 or claude-opus-5 for noticeably better
                                        # small-talk/summary quality at a higher per-token cost
# GROQ_STT_MODEL=whisper-large-v3
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_VOICE=Kore

# Text-to-speech engine tried first for each language: gemini | elevenlabs | edge
# (the other two are used automatically as fallbacks if the first one fails or has no key).
# Gemini TTS is the primary engine by default — no ElevenLabs key required to run the app.
# Set these to "elevenlabs" instead if you have an ElevenLabs voice you'd rather use.
# TTS_ENGINE_EN=gemini
# TTS_ENGINE_NE=gemini
# ELEVENLABS_VOICE_ID=FL6uoOl4FRyQjIxYJbjj     # https://elevenlabs.io/voices/FL6uoOl4FRyQjIxYJbjj
# ELEVENLABS_MODEL_EN=eleven_multilingual_v2
# ELEVENLABS_MODEL_NE=eleven_v3               # multilingual_v2 does not support Nepali
# EDGE_VOICE_EN=en-US-JennyNeural
# EDGE_VOICE_NE=ne-NP-HemkalaNeural     # or ne-NP-SagarNeural (male)

# REMINDER_CHECK_SECONDS=20
# HTTP_TIMEOUT=15
# SERVER_HOST=127.0.0.1                 # keep 127.0.0.1 for a local, single-user app
# SERVER_PORT=7860
# APP_AUTH=username:password            # set this if you ever expose the app beyond localhost
# DATA_DIR=data                         # folder holding conversations/reminders/tasks/settings.json
